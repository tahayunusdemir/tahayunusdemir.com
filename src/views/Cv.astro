---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import Icon from "@/components/Icon.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { formatMonth, localizePath, otherLang } from "@/i18n/utils";
import { certifications, cvPdf, cvProjects, education, skills, spokenLanguages, summary } from "@/data/cv";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const range = (s: string, e: string | null) =>
  `${formatMonth(s, lang, tr("cv.present"))} – ${formatMonth(e, lang, tr("cv.present"))}`;
---

<BaseLayout lang={lang} title={tr("cv.title")} description={tr("cv.description")} ogImage={`/og/${lang}/cv.png`}>
  <div class="container-page">
    <PageHeader title={tr("cv.title")} description={tr("cv.description")}>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={cvPdf[lang]} class="btn-primary" download>
          <Icon name="lucide:download" /> {tr("cv.download")}
        </a>
        <a href={cvPdf[otherLang(lang)]} class="btn-secondary" download>
          <Icon name="lucide:download" /> {tr("cv.downloadOther")}
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-600 dark:text-zinc-400">
        <li class="inline-flex items-center gap-1.5"><Icon name="lucide:map-pin" /> Ankara, {lang === "tr" ? "Türkiye" : "Türkiye"}</li>
        <li><a class="inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-zinc-100" href={`mailto:${SITE.email}`}><Icon name="lucide:mail" /> {SITE.email}</a></li>
        <li><a class="inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-zinc-100" href={SITE.linkedin} target="_blank" rel="noopener"><Icon name="mdi:linkedin" /> taha-yunus-demir</a></li>
        <li><a class="inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-zinc-100" href={SITE.github} target="_blank" rel="noopener"><Icon name="mdi:github" /> {SITE.githubUser}</a></li>
      </ul>
    </PageHeader>

    <div class="space-y-16">
      <section aria-labelledby="summary">
        <h2 id="summary" class="section-title">{tr("cv.summary")}</h2>
        <p class="text-[17px] leading-relaxed">{summary[lang]}</p>
      </section>

      <section aria-labelledby="experience">
        <h2 id="experience" class="section-title">{tr("cv.experience")}</h2>
        <ExperienceList lang={lang} />
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects" class="section-title">{tr("cv.projects")}</h2>
        <div class="space-y-8">
          {cvProjects.map((p) => (
            <div>
              <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <h3 class="font-semibold">
                  <a class="link" href={localizePath(`/projects/${p.slug}`, lang)}>{p.name[lang]}</a>
                </h3>
                <p class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-400">{range(p.start, p.end)}</p>
              </div>
              <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{p.summary[lang]}</p>
              <ul class="mt-3 space-y-2 text-[15px] leading-relaxed">
                {p.highlights[lang].map((h) => (
                  <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:size-1 before:rounded-full before:bg-zinc-400">{h}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="education">
        <h2 id="education" class="section-title">{tr("cv.education")}</h2>
        <div class="space-y-6">
          {education.map((e) => (
            <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <div>
                <h3 class="font-semibold">{e.institution[lang]}</h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-400">{e.area[lang]} · {e.location[lang]}</p>
              </div>
              <p class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-400">{range(e.start, e.end)}</p>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="certs">
        <h2 id="certs" class="section-title">{tr("cv.certifications")}</h2>
        <ul class="space-y-2 text-[15px] leading-relaxed">
          {certifications.map((c) => <li>{c[lang]}</li>)}
        </ul>
      </section>

      <section aria-labelledby="skills">
        <h2 id="skills" class="section-title">{tr("cv.skills")}</h2>
        <dl class="space-y-4">
          {skills.map((s) => (
            <div class="grid gap-2 sm:grid-cols-[180px_1fr]">
              <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{s.label[lang]}</dt>
              <dd class="flex flex-wrap gap-1.5">{s.items.map((i) => <span class="chip">{i}</span>)}</dd>
            </div>
          ))}
          <div class="grid gap-2 sm:grid-cols-[180px_1fr]">
            <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{tr("cv.languages")}</dt>
            <dd class="text-sm">{spokenLanguages[lang]}</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>
