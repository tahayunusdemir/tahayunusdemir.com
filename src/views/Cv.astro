---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Separator from "@/components/ui/Separator.astro";
import Panel from "@/components/ui/Panel.astro";
import Icon from "@/components/Icon.astro";
import Experience from "@/components/home/Experience.astro";
import Projects from "@/components/home/Projects.astro";
import Education from "@/components/home/Education.astro";
import Skills from "@/components/home/Skills.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { otherLang } from "@/i18n/utils";
import { cvPdf, summary } from "@/data/cv";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<BaseLayout lang={lang} title={tr("cv.title")} description={tr("cv.description")} ogImage={`/og/${lang}/cv.png`}>
  <div class="screen-line-bottom px-4 pt-12 pb-6">
    <p class="blur-in font-mono text-sm text-muted-foreground">{SITE.name}</p>
    <h1 class="blur-in mt-1 text-4xl font-medium tracking-tight" style="--i:1">{tr("cv.title")}</h1>
    <p class="blur-in mt-3 max-w-xl text-muted-foreground" style="--i:2">{tr("role")} · Ankara, Türkiye</p>
    <div class="blur-in mt-6 flex flex-wrap gap-2" style="--i:3">
      <a href={cvPdf[lang]} class="btn-primary" download><Icon name="lucide:download" class="size-4" />{tr("cv.download")}</a>
      <a href={cvPdf[otherLang(lang)]} class="btn-outline" download><Icon name="lucide:download" class="size-4" />{tr("cv.downloadOther")}</a>
      <a href={`mailto:${SITE.email}`} class="btn-outline"><Icon name="lucide:mail" class="size-4" />{SITE.email}</a>
    </div>
  </div>
  <Separator />
  <Panel id="summary" title={tr("cv.summary")}>
    <p class="p-4 text-[15px] leading-relaxed">{summary[lang]}</p>
  </Panel>
  <Separator />
  <Experience lang={lang} expanded />
  <Separator />
  <Projects lang={lang} expanded />
  <Separator />
  <Education lang={lang} />
  <Separator />
  <Skills lang={lang} />
</BaseLayout>
