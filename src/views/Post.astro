---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { formatDate, localizePath, otherLang } from "@/i18n/utils";
import { hasTranslation, readingTime, splitId, tagSlug, type Post } from "@/lib/content";

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const tr = t(lang);
const { slug } = splitId(post.id);
const { Content, headings } = await render(post);
const d = post.data;
const altLang = otherLang(lang);
const alt = (await hasTranslation("blog", slug, altLang)) ? localizePath(`/blog/${slug}`, altLang) : null;
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(Astro.url.pathname, SITE.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  inLanguage: lang,
  url,
  image: new URL(`/og/${lang}/blog/${slug}.png`, SITE.url).href,
  author: { "@type": "Person", name: SITE.name, url: SITE.url },
  keywords: d.tags.join(", "),
};
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.description}
  type="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
  tags={d.tags}
  altHref={alt}
  ogImage={`/og/${lang}/blog/${slug}.png`}
  jsonLd={jsonLd}
>
  <article class="container-page">
    <header class="pt-12 pb-10 sm:pt-16">
      <a href={localizePath("/blog", lang)} class="inline-flex items-center gap-1 text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
        <Icon name="lucide:arrow-left" /> {tr("blog.back")}
      </a>
      <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{d.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{d.description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
        {d.updatedDate && <span>{tr("blog.updated")}: {formatDate(d.updatedDate, lang)}</span>}
        <span>{readingTime(post.body)} {tr("blog.readingTime")}</span>
        {alt && (
          <a href={alt} hreflang={altLang} class="inline-flex items-center gap-1 underline underline-offset-4 hover:text-zinc-900 dark:hover:text-zinc-100">
            <Icon name="lucide:languages" class="size-3.5" /> {tr("blog.otherLang")}
          </a>
        )}
      </div>
      {d.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={tr("blog.tags")}>
          {d.tags.map((tag) => (
            <li><a href={localizePath(`/blog/tags/${tagSlug(tag)}`, lang)} class="chip hover:text-zinc-900 dark:hover:text-zinc-100">#{tag}</a></li>
          ))}
        </ul>
      )}
    </header>

    {
      toc.length > 2 && (
        <nav class="card mb-10 p-5 text-sm" aria-label="Table of contents">
          <ol class="list-inside list-decimal space-y-1.5 marker:font-mono marker:text-zinc-400">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-headings:tracking-tight prose-h2:mt-12">
      <Content />
    </div>

    <footer class="mt-16 flex flex-col gap-4 border-t border-zinc-200 pt-8 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800">
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        {lang === "tr" ? "Yorum ya da sorunuz mu var? " : "Questions or feedback? "}
        <a class="link" href={`mailto:${SITE.email}?subject=${encodeURIComponent(d.title)}`}>{SITE.email}</a>
      </p>
      <a href={localizePath("/blog", lang)} class="btn-secondary self-start">
        <Icon name="lucide:arrow-left" /> {tr("blog.back")}
      </a>
    </footer>
  </article>
</BaseLayout>
