---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PostList from "@/components/PostList.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import Icon from "@/components/Icon.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath } from "@/i18n/utils";
import { getPosts, getProjects } from "@/lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const projects = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 4);
const posts = (await getPosts(lang)).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: tr("role"),
  address: { "@type": "PostalAddress", addressLocality: "Ankara", addressCountry: "TR" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Kütahya Dumlupınar Üniversitesi" },
    { "@type": "CollegeOrUniversity", name: "Universidade da Beira Interior" },
  ],
  sameAs: [SITE.github, SITE.linkedin],
  knowsAbout: ["Android", "Kotlin", "Jetpack Compose", "Next.js", "TypeScript", "Django", "FastAPI"],
};
---

<BaseLayout lang={lang} jsonLd={jsonLd}>
  <div class="container-page">
    <!-- Hero -->
    <section class="pt-16 pb-14 sm:pt-24 sm:pb-20">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{tr("home.hello")}</h1>
      <p class="mt-3 font-mono text-sm text-zinc-500 sm:text-base dark:text-zinc-400">{tr("role")}</p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
        {tr("home.intro")}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={localizePath("/cv", lang)} class="btn-primary">
          <Icon name="lucide:file-text" />
          {tr("home.ctaCv")}
        </a>
        <a href={`mailto:${SITE.email}`} class="btn-secondary">
          <Icon name="lucide:mail" />
          {tr("home.ctaContact")}
        </a>
        <div class="flex items-center gap-1 sm:ml-2">
          <a
            href={SITE.github}
            target="_blank"
            rel="me noopener"
            aria-label="GitHub"
            class="grid size-10 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
            ><Icon name="mdi:github" class="size-5" /></a
          >
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="me noopener"
            aria-label="LinkedIn"
            class="grid size-10 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
            ><Icon name="mdi:linkedin" class="size-5" /></a
          >
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="mb-20" aria-labelledby="featured">
      <h2 id="featured" class="section-title">
        {tr("home.featured")}
        <a href={localizePath("/projects", lang)} class="normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("home.allProjects")} →</a
        >
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-20" aria-labelledby="exp">
      <h2 id="exp" class="section-title">
        {tr("home.experience")}
        <a href={localizePath("/cv", lang)} class="normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("home.fullCv")} →</a
        >
      </h2>
      <ExperienceList lang={lang} compact />
    </section>

    <!-- Posts -->
    <section class="mb-20" aria-labelledby="posts">
      <h2 id="posts" class="section-title">
        {tr("home.latest")}
        <a href={localizePath("/blog", lang)} class="normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("home.allPosts")} →</a
        >
      </h2>
      <PostList posts={posts} lang={lang} />
    </section>

    <!-- Contact -->
    <section class="card p-6 sm:p-8" aria-labelledby="contact">
      <h2 id="contact" class="text-xl font-semibold">{tr("home.contactTitle")}</h2>
      <p class="mt-2 max-w-xl text-zinc-600 dark:text-zinc-400">{tr("home.contactText")}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={`mailto:${SITE.email}`} class="btn-primary"><Icon name="lucide:mail" />{SITE.email}</a>
        <a href={SITE.linkedin} target="_blank" rel="me noopener" class="btn-secondary"><Icon name="mdi:linkedin" />LinkedIn</a>
      </div>
    </section>
  </div>
</BaseLayout>
