---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import PostList from "@/components/PostList.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import Icon from "@/components/Icon.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath } from "@/i18n/utils";
import { getPosts, getProjects } from "@/lib/content";
import { education, experience, skills } from "@/data/cv";
import { formatMonth } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const projects = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 4);
const posts = (await getPosts(lang)).slice(0, 3);
const current = experience.find((e) => e.end === null)!;
const overview = [
  { icon: "lucide:briefcase", text: lang === "tr" ? `${current.company} kurucusu` : `Founder of ${current.company}`, href: current.url },
  { icon: "lucide:graduation-cap", text: education[0].institution[lang] },
  { icon: "lucide:map-pin", text: "Ankara, Türkiye" },
  { icon: "lucide:mail", text: SITE.email, href: `mailto:${SITE.email}` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: tr("role"),
  address: { "@type": "PostalAddress", addressLocality: "Ankara", addressCountry: "TR" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Kütahya Dumlupınar Üniversitesi" },
    { "@type": "CollegeOrUniversity", name: "Universidade da Beira Interior" },
  ],
  sameAs: [SITE.github, SITE.linkedin],
  knowsAbout: ["Android", "Kotlin", "Jetpack Compose", "Next.js", "TypeScript", "Django", "FastAPI"],
};
---

<BaseLayout lang={lang} jsonLd={jsonLd}>
  <div class="container-page">
    <!-- Hero -->
    <section class="pt-16 pb-14 sm:pt-24 sm:pb-20">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{SITE.name}</h1>
      <p class="mt-3 text-xl font-medium text-zinc-500 sm:text-2xl dark:text-zinc-400">{tr("home.tagline")}</p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
        {tr("home.intro")}
      </p>
      <ul class="mt-8 grid gap-x-6 gap-y-2.5 text-sm text-zinc-600 sm:grid-cols-2 dark:text-zinc-400">
        {
          overview.map((o) => (
            <li class="flex min-w-0 items-center gap-2.5">
              <Icon name={o.icon} class="size-4 shrink-0 text-zinc-400 dark:text-zinc-500" />
              {o.href ? (
                <a href={o.href} class="truncate hover:text-zinc-900 dark:hover:text-zinc-100" {...(o.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
                  {o.text}
                </a>
              ) : (
                <span class="truncate">{o.text}</span>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={localizePath("/cv", lang)} class="btn-primary">
          <Icon name="lucide:file-text" />
          {tr("home.ctaCv")}
        </a>
        <a href={`mailto:${SITE.email}`} class="btn-secondary">
          <Icon name="lucide:mail" />
          {tr("home.ctaContact")}
        </a>
        <div class="flex items-center gap-1 sm:ml-2">
          <a
            href={SITE.github}
            target="_blank"
            rel="me noopener"
            aria-label="GitHub"
            class="grid size-10 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
            ><Icon name="mdi:github" class="size-5" /></a
          >
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="me noopener"
            aria-label="LinkedIn"
            class="grid size-10 place-items-center rounded-lg text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
            ><Icon name="mdi:linkedin" class="size-5" /></a
          >
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="mb-20" aria-labelledby="featured">
      <h2 id="featured" class="section-title">
        {tr("home.featured")}
        <a href={localizePath("/projects", lang)} class="normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("home.allProjects")} →</a
        >
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-20" aria-labelledby="exp">
      <h2 id="exp" class="section-title">
        {tr("home.experience")}
        <a href={localizePath("/cv", lang)} class="normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("home.fullCv")} →</a
        >
      </h2>
      <ExperienceList lang={lang} compact />
    </section>

    <!-- Education -->
    <section class="mb-20" aria-labelledby="edu">
      <h2 id="edu" class="section-title">{tr("cv.education")}</h2>
      <ul class="space-y-5">
        {
          education.map((e) => (
            <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <div>
                <h3 class="font-semibold">{e.institution[lang]}</h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-400">{e.area[lang]} · {e.location[lang]}</p>
              </div>
              <p class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-400">
                {formatMonth(e.start, lang, tr("cv.present"))} – {formatMonth(e.end, lang, tr("cv.present"))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Skills -->
    <section class="mb-20" aria-labelledby="skills">
      <h2 id="skills" class="section-title">{tr("cv.skills")}</h2>
      <dl class="space-y-4">
        {
          skills.map((g) => (
            <div class="grid gap-2 sm:grid-cols-[170px_1fr]">
              <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{g.label[lang]}</dt>
              <dd class="flex flex-wrap gap-1.5">{g.items.map((i) => <span class="chip">{i}</span>)}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Posts -->
    <section class="mb-20" aria-labelledby="posts">
      <h2 id="posts" class="section-title">
        {tr("home.latest")}
        <a href={localizePath("/blog", lang)} class="normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("home.allPosts")} →</a
        >
      </h2>
      <PostList posts={posts} lang={lang} />
    </section>

    <!-- Contact -->
    <section class="card p-6 sm:p-8" aria-labelledby="contact">
      <h2 id="contact" class="text-xl font-semibold">{tr("home.contactTitle")}</h2>
      <p class="mt-2 max-w-xl text-zinc-600 dark:text-zinc-400">{tr("home.contactText")}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={`mailto:${SITE.email}`} class="btn-primary"><Icon name="lucide:mail" />{SITE.email}</a>
        <a href={SITE.linkedin} target="_blank" rel="me noopener" class="btn-secondary"><Icon name="mdi:linkedin" />LinkedIn</a>
      </div>
    </section>
  </div>
</BaseLayout>
