---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ExperienceList from "@/components/ExperienceList.astro";
import Icon from "@/components/Icon.astro";
import HeroBackground from "@/components/fx/HeroBackground.astro";
import Stats from "@/components/fx/Stats.astro";
import TechMarquee from "@/components/fx/TechMarquee.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { formatMonth, localizePath } from "@/i18n/utils";
import { getProjects } from "@/lib/content";
import { education, experience, skills } from "@/data/cv";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const projects = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 4);
const current = experience.find((e) => e.end === null)!;
const words = ["Android", "web", "full stack"];

const overview = [
  { icon: "lucide:briefcase", text: lang === "tr" ? `${current.company} kurucusu` : `Founder of ${current.company}`, href: current.url },
  { icon: "lucide:graduation-cap", text: education[0].institution[lang] },
  { icon: "lucide:map-pin", text: "Ankara, Türkiye" },
  { icon: "lucide:mail", text: SITE.email, href: `mailto:${SITE.email}` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  jobTitle: tr("role"),
  address: { "@type": "PostalAddress", addressLocality: "Ankara", addressCountry: "TR" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Kütahya Dumlupınar Üniversitesi" },
    { "@type": "CollegeOrUniversity", name: "Universidade da Beira Interior" },
  ],
  sameAs: [SITE.github, SITE.linkedin],
  knowsAbout: ["Android", "Kotlin", "Jetpack Compose", "Next.js", "TypeScript", "Django", "FastAPI"],
};

const sectionLink =
  "group/link inline-flex items-center gap-1 normal-case tracking-normal hover:text-zinc-900 dark:hover:text-zinc-100";
---

<BaseLayout lang={lang} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative isolate -mt-px" data-hero>
    <HeroBackground />
    <div class="container-page pt-20 pb-16 sm:pt-28 sm:pb-24">
      <a
        href={current.url}
        target="_blank"
        rel="noopener"
        class="blur-in group mb-7 inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white/70 py-1 pr-3 pl-1 text-xs font-medium text-zinc-700 backdrop-blur transition-colors hover:border-accent-300 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-300 dark:hover:border-accent-700"
        style="--i:0"
      >
        <span class="rounded-full bg-accent-600 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white uppercase">
          {lang === "tr" ? "Yeni" : "New"}
        </span>
        {lang === "tr" ? "CineMention yayında" : "CineMention is live"}
        <Icon name="lucide:arrow-right" class="size-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>

      <h1 class="blur-in text-5xl font-bold tracking-tighter sm:text-7xl" style="--i:1">
        <span class="text-gradient">{SITE.name}</span>
      </h1>

      <p
        class="blur-in mt-5 text-xl font-medium text-zinc-600 sm:text-2xl dark:text-zinc-300"
        style="--i:2"
        aria-label={tr("home.tagline")}
      >
        <span aria-hidden="true">
          {tr("home.taglinePre")}{" "}
          <span class="rotator text-zinc-900 dark:text-white" data-rotator>
            {words.map((w, i) => <span class:list={["whitespace-nowrap", i === 0 && "is-active"]}>{w}</span>)}
          </span>{" "}
          {tr("home.taglinePost")}
        </span>
      </p>

      <p class="blur-in mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400" style="--i:3">
        {tr("home.intro")}
      </p>

      <ul class="blur-in mt-8 grid gap-x-6 gap-y-2.5 text-sm text-zinc-600 sm:grid-cols-2 dark:text-zinc-400" style="--i:4">
        {
          overview.map((o) => (
            <li class="flex min-w-0 items-center gap-2.5">
              <span class="grid size-7 shrink-0 place-items-center rounded-md border border-zinc-200 bg-white/70 dark:border-zinc-800 dark:bg-zinc-900/60">
                <Icon name={o.icon} class="size-3.5 text-zinc-500 dark:text-zinc-400" />
              </span>
              {o.href ? (
                <a href={o.href} class="truncate hover:text-zinc-900 dark:hover:text-zinc-100" {...(o.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
                  {o.text}
                </a>
              ) : (
                <span class="truncate">{o.text}</span>
              )}
            </li>
          ))
        }
      </ul>

      <div class="blur-in mt-10 flex flex-wrap items-center gap-3" style="--i:5">
        <a href={localizePath("/cv", lang)} class="btn-primary btn-shine px-5 py-2.5 shadow-lg shadow-accent-600/10">
          <Icon name="lucide:file-text" />
          {tr("home.ctaCv")}
        </a>
        <a href={`mailto:${SITE.email}`} class="btn-secondary bg-white/60 px-5 py-2.5 backdrop-blur dark:bg-zinc-900/40">
          <Icon name="lucide:mail" />
          {tr("home.ctaContact")}
        </a>
        <div class="flex items-center gap-1 sm:ml-2">
          {
            [
              { href: SITE.github, label: "GitHub", icon: "mdi:github" },
              { href: SITE.linkedin, label: "LinkedIn", icon: "mdi:linkedin" },
            ].map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="me noopener"
                aria-label={s.label}
                class="grid size-10 place-items-center rounded-lg text-zinc-500 transition-all hover:-translate-y-0.5 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
              >
                <Icon name={s.icon} class="size-5" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <div class="container-page">
    <!-- Stats -->
    <section class="mb-14" aria-label={tr("home.stats")}>
      <Stats lang={lang} />
    </section>

    <!-- Marquee -->
    <section class="reveal mb-24" aria-labelledby="marquee">
      <h2 id="marquee" class="mb-4 text-center font-mono text-xs tracking-widest text-zinc-500 uppercase dark:text-zinc-500">
        {tr("home.marquee")}
      </h2>
      <TechMarquee />
    </section>

    <!-- Projects (bento) -->
    <section class="mb-24" aria-labelledby="featured">
      <h2 id="featured" class="section-title reveal">
        {tr("home.featured")}
        <a href={localizePath("/projects", lang)} class={sectionLink}
          >{tr("home.allProjects")} <span class="transition-transform group-hover/link:translate-x-0.5">→</span></a
        >
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          projects.map((p, i) => (
            <div class:list={["reveal flex", (i === 0 || i === 3) && "sm:col-span-2"]} style={`--i:${i % 2}`}>
              <ProjectCard project={p} lang={lang} wide={i === 0 || i === 3} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Experience -->
    <section class="reveal mb-24" aria-labelledby="exp">
      <h2 id="exp" class="section-title">
        {tr("home.experience")}
        <a href={localizePath("/cv", lang)} class={sectionLink}
          >{tr("home.fullCv")} <span class="transition-transform group-hover/link:translate-x-0.5">→</span></a
        >
      </h2>
      <ExperienceList lang={lang} compact />
    </section>

    <!-- Education + Skills -->
    <div class="mb-24 grid gap-14">
      <section class="reveal" aria-labelledby="edu">
        <h2 id="edu" class="section-title">{tr("cv.education")}</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            education.map((e) => (
              <li class="card spotlight rounded-2xl p-5">
                <p class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
                  {formatMonth(e.start, lang, tr("cv.present"))} – {formatMonth(e.end, lang, tr("cv.present"))}
                </p>
                <h3 class="mt-2 font-semibold">{e.institution[lang]}</h3>
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{e.area[lang]}</p>
                <p class="mt-1 text-sm text-zinc-500">{e.location[lang]}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="reveal" aria-labelledby="skills">
        <h2 id="skills" class="section-title">{tr("cv.skills")}</h2>
        <dl class="space-y-4">
          {
            skills.map((g) => (
              <div class="grid gap-2 sm:grid-cols-[170px_1fr]">
                <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{g.label[lang]}</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {g.items.map((i) => (
                    <span class="chip transition-colors hover:border-accent-400 hover:text-zinc-900 dark:hover:border-accent-600 dark:hover:text-zinc-100">{i}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <!-- Contact -->
    <section
      class="reveal relative isolate overflow-hidden rounded-3xl border border-zinc-200 bg-zinc-950 p-8 text-center sm:p-12 dark:border-zinc-800"
      aria-labelledby="contact"
    >
      <div class="animate-aurora absolute -top-24 left-1/4 -z-10 size-80 rounded-full bg-accent-500/30 blur-[100px]" aria-hidden="true"></div>
      <div class="animate-aurora absolute -right-10 -bottom-24 -z-10 size-72 rounded-full bg-sky-500/20 blur-[100px] [animation-delay:-8s]" aria-hidden="true"></div>
      <h2 id="contact" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{tr("home.contactTitle")}</h2>
      <p class="mx-auto mt-3 max-w-lg text-zinc-400">{tr("home.contactText")}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${SITE.email}`} class="btn-shine inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-100">
          <Icon name="lucide:mail" />{SITE.email}
        </a>
        <a href={SITE.linkedin} target="_blank" rel="me noopener" class="inline-flex items-center gap-2 rounded-lg border border-zinc-700 px-5 py-2.5 text-sm font-medium text-zinc-200 transition-colors hover:border-zinc-500 hover:text-white">
          <Icon name="mdi:linkedin" />LinkedIn
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
