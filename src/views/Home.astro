---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Separator from "@/components/ui/Separator.astro";
import ProfileHeader from "@/components/home/ProfileHeader.astro";
import Overview from "@/components/home/Overview.astro";
import SocialLinks from "@/components/home/SocialLinks.astro";
import Contributions from "@/components/home/Contributions.astro";
import About from "@/components/home/About.astro";
import Numbers from "@/components/home/Numbers.astro";
import TechStack from "@/components/home/TechStack.astro";
import Experience from "@/components/home/Experience.astro";
import Projects from "@/components/home/Projects.astro";
import Education from "@/components/home/Education.astro";
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    jobTitle: tr("role"),
    address: { "@type": "PostalAddress", addressLocality: "Ankara", addressCountry: "TR" },
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "Kütahya Dumlupınar Üniversitesi" },
      { "@type": "CollegeOrUniversity", name: "Universidade da Beira Interior" },
    ],
    sameAs: [SITE.github, SITE.linkedin],
    knowsAbout: ["Android", "Kotlin", "Jetpack Compose", "Next.js", "TypeScript", "Django", "FastAPI"],
  },
};
---

<BaseLayout lang={lang} jsonLd={jsonLd}>
  <ProfileHeader lang={lang} />
  <Separator />
  <Overview lang={lang} />
  <SocialLinks lang={lang} />
  <Contributions lang={lang} />
  <Separator />
  <About lang={lang} />
  <Separator />
  <Numbers lang={lang} />
  <Separator />
  <TechStack lang={lang} />
  <Separator />
  <Experience lang={lang} />
  <Separator />
  <Projects lang={lang} />
  <Separator />
  <Education lang={lang} />
</BaseLayout>
