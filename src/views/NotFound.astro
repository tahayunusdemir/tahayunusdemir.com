---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<BaseLayout lang={lang} title={tr("404.title")} noindex altHref={localizePath("/", lang === "tr" ? "en" : "tr")}>
  <div class="dot-grid screen-line-bottom px-4 py-28 text-center">
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="mt-3 text-4xl font-medium tracking-tight">{tr("404.title")}</h1>
    <p class="mt-3 text-muted-foreground">{tr("404.text")}</p>
    <a href={localizePath("/", lang)} class="btn-primary mt-8">{tr("404.home")}</a>
  </div>
</BaseLayout>
