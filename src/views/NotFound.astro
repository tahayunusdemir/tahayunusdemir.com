---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<BaseLayout lang={lang} title={tr("404.title")} noindex altHref={localizePath("/", lang === "tr" ? "en" : "tr")}>
  <div class="container-page py-24 text-center sm:py-32">
    <p class="font-mono text-sm text-accent-700 dark:text-accent-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{tr("404.title")}</h1>
    <p class="mt-4 text-zinc-600 dark:text-zinc-400">{tr("404.text")}</p>
    <a href={localizePath("/", lang)} class="btn-primary mt-8">{tr("404.home")}</a>
  </div>
</BaseLayout>
