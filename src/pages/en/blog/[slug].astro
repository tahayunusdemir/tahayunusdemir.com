---
import View from "@/views/Post.astro";
import { getPosts, splitId, type Post } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPosts("en");
  return posts.map((post) => ({ params: { slug: splitId(post.id).slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---

<View lang="en" post={post} />
