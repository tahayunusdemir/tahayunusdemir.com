---
import View from "@/views/Blog.astro";
import { getPosts, tagSlug } from "@/lib/content";

export async function getStaticPaths() {
  const posts = await getPosts("tr");
  const tags = new Map<string, string>();
  posts.flatMap((p) => p.data.tags).forEach((t) => tags.set(tagSlug(t), t));
  return [...tags].map(([slug, name]) => ({ params: { tag: slug }, props: { name } }));
}
const { name } = Astro.props as { name: string };
---

<View lang="tr" tag={name} />
