---
import Panel from "@/components/ui/Panel.astro";
import type { Lang } from "@/consts";
import { skills, spokenLanguages } from "@/data/cv";
import { t } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<Panel id="skills" title={tr("cv.skills")}>
  <dl class="space-y-4 p-4">
    {
      skills.map((g) => (
        <div class="grid gap-2 sm:grid-cols-[170px_1fr]">
          <dt class="text-sm font-medium">{g.label[lang]}</dt>
          <dd class="flex flex-wrap gap-1.5">
            {g.items.map((i) => (
              <span class="tag">{i}</span>
            ))}
          </dd>
        </div>
      ))
    }
    <div class="grid gap-2 sm:grid-cols-[170px_1fr]">
      <dt class="text-sm font-medium">{tr("cv.languages")}</dt>
      <dd class="text-sm text-muted-foreground">{spokenLanguages[lang]}</dd>
    </div>
  </dl>
</Panel>
