---
import Panel from "@/components/ui/Panel.astro";
import type { Lang } from "@/consts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Yalnızca doğrulanmış sayılar (profil-gercekleri.md).
const stats = [
  { value: 140, suffix: "+", tr: "sayfalık web uygulaması", en: "page web app", ctx: "CineMention" },
  { value: 25, suffix: "", tr: "modüllü Android uygulaması", en: "module Android app", ctx: "CineMention" },
  { value: 160, suffix: "", tr: "sürümlü SQL migration", en: "versioned SQL migrations", ctx: "CineMention" },
  { value: 81, suffix: "", tr: "ilde yardım noktası", en: "provinces mapped", ctx: "AYİKA" },
];
---

<Panel>
  <h2 class="sr-only">{lang === "tr" ? "Rakamlarla" : "By the numbers"}</h2>
  <dl class="grid grid-cols-2 gap-px bg-line sm:grid-cols-4">
    {
      stats.map((s) => (
        <div class="bg-background p-4">
          <dt class="sr-only">{s[lang]}</dt>
          <dd>
            <span class="block text-3xl font-medium tracking-tight tabular-nums">
              <span data-count={s.value}>{s.value}</span>
              {s.suffix}
            </span>
            <span class="mt-1 block text-sm text-muted-foreground">{s[lang]}</span>
            <span class="mt-2 block font-mono text-[11px] tracking-wide text-muted-foreground/80 uppercase">{s.ctx}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</Panel>
