---
import Icon from "@/components/Icon.astro";
import Panel from "@/components/ui/Panel.astro";
import Separator from "@/components/ui/Separator.astro";
import type { Lang } from "@/consts";
import { certifications, education } from "@/data/cv";
import { t } from "@/i18n/ui";
import { formatMonth } from "@/i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
---

<Panel id="education" title={tr("cv.education")}>
  <ul class="px-4">
    {
      education.map((e) => (
        <li class="screen-line-bottom flex gap-3 py-4 last:after:hidden">
          <span class="icon-tile mt-0.5">
            <Icon name="lucide:graduation-cap" class="size-3.5" />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <h3 class="font-medium">{e.institution[lang]}</h3>
              <p class="shrink-0 font-mono text-sm text-muted-foreground tabular-nums">
                {formatMonth(e.start, lang, tr("cv.present"))} — {formatMonth(e.end, lang, tr("cv.present"))}
              </p>
            </div>
            <p class="mt-1 text-sm text-muted-foreground">
              {e.area[lang]} · {e.location[lang]}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Panel>

<Separator />

<Panel id="certifications" title={tr("cv.certifications")}>
  <ul class="px-4">
    {
      certifications.map((c) => {
        const [head, ...rest] = c[lang].split(": ");
        return (
          <li class="flex gap-3 py-4">
            <span class="icon-tile mt-0.5">
              <Icon name="lucide:award" class="size-3.5" />
            </span>
            <div>
              <h3 class="font-medium">{head}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{rest.join(": ")}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</Panel>
