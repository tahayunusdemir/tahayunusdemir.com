---
import Icon from "@/components/Icon.astro";
import Panel from "@/components/ui/Panel.astro";
import { SITE, type Lang } from "@/consts";
import { education } from "@/data/cv";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === "tr";

const items: { icon: string; text: string; href?: string; clock?: boolean }[] = [
  { icon: "lucide:code-xml", text: tr ? "Yazılım Geliştirici · Android ve Web" : "Software Developer · Android and Web" },
  { icon: "lucide:briefcase-business", text: tr ? "Kurucu @CineMention" : "Founder @CineMention", href: "https://cinemention.com" },
  { icon: "lucide:graduation-cap", text: education[0].institution[lang] },
  { icon: "lucide:map-pin", text: "Ankara, Türkiye" },
  { icon: "lucide:clock", text: "", clock: true },
  { icon: "lucide:mail", text: SITE.email, href: `mailto:${SITE.email}` },
];
---

<Panel reveal={false}>
  <h2 class="sr-only">{tr ? "Genel bakış" : "Overview"}</h2>
  <ul class="grid gap-x-4 gap-y-2.5 p-4 font-mono text-sm sm:grid-cols-2">
    {
      items.map((it, i) => (
        <li class="blur-in flex min-w-0 items-center gap-3" style={`--i:${i + 3}`}>
          <span class="icon-tile">
            <Icon name={it.icon} class="size-3.5" />
          </span>
          {it.clock ? (
            <span class="truncate" data-clock data-tz="Europe/Istanbul" data-lang={lang}>
              <span data-clock-time>--:--</span>
              <span class="text-muted-foreground"> // {tr ? "Türkiye saati" : "Türkiye time"}</span>
            </span>
          ) : it.href ? (
            <a href={it.href} class="link-underline truncate" {...(it.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>
              {it.text}
            </a>
          ) : (
            <span class="truncate">{it.text}</span>
          )}
        </li>
      ))
    }
  </ul>
</Panel>
