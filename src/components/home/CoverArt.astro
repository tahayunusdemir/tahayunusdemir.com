---
// Özgün kapak çizimi: bir Android telefon ve bir tarayıcı penceresi, ölçü çizgileriyle.
// "Android + web" mesajını teknik çizim diliyle anlatır. Çizgiler açılışta çizilerek belirir.
import type { Lang } from "@/consts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<svg
  class="draw absolute inset-0 size-full text-muted-foreground"
  viewBox="0 0 560 210"
  preserveAspectRatio="xMidYMid meet"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- Tarayıcı penceresi -->
  <g class="float" style="animation-delay:-2s">
    <rect x="200" y="34" width="250" height="148" rx="10" stroke-width="1.2" style="--d:0" />
    <line x1="200" y1="56" x2="450" y2="56" stroke-width="1" style="--d:200" />
    <circle cx="214" cy="45" r="3" stroke-width="1" style="--d:300" />
    <circle cx="225" cy="45" r="3" stroke-width="1" style="--d:350" />
    <circle cx="236" cy="45" r="3" stroke-width="1" style="--d:400" />
    <rect x="252" y="40" width="150" height="10" rx="5" stroke-width="0.8" style="--d:450" />
    <!-- içerik iskeleti -->
    <rect x="216" y="70" width="96" height="10" rx="3" stroke-width="0.9" style="--d:600" />
    <line x1="216" y1="92" x2="330" y2="92" stroke-width="0.8" style="--d:700" />
    <line x1="216" y1="102" x2="310" y2="102" stroke-width="0.8" style="--d:750" />
    <line x1="216" y1="112" x2="322" y2="112" stroke-width="0.8" style="--d:800" />
    <rect x="216" y="128" width="58" height="40" rx="5" stroke-width="0.9" style="--d:900" />
    <rect x="282" y="128" width="58" height="40" rx="5" stroke-width="0.9" style="--d:950" />
    <rect x="350" y="70" width="86" height="98" rx="6" stroke-width="0.9" style="--d:1000" />
    <path d="M362 150 l14 -18 l12 10 l16 -24 l18 32" stroke-width="0.9" style="--d:1200" />
  </g>

  <!-- Android telefon -->
  <g class="float">
    <rect x="96" y="48" width="78" height="146" rx="14" stroke-width="1.2" class="fill-background" style="--d:100" />
    <line x1="124" y1="58" x2="146" y2="58" stroke-width="1.6" style="--d:300" />
    <rect x="106" y="70" width="58" height="10" rx="3" stroke-width="0.9" style="--d:500" />
    <rect x="106" y="88" width="58" height="34" rx="5" stroke-width="0.9" style="--d:650" />
    <line x1="106" y1="132" x2="160" y2="132" stroke-width="0.8" style="--d:750" />
    <line x1="106" y1="141" x2="148" y2="141" stroke-width="0.8" style="--d:800" />
    <rect x="106" y="152" width="58" height="16" rx="8" stroke-width="0.9" style="--d:900" />
    <line x1="122" y1="183" x2="148" y2="183" stroke-width="1.4" style="--d:1000" />
  </g>

  <!-- Ölçü çizgileri -->
  <g stroke-width="0.7" class="opacity-70">
    <line x1="86" y1="48" x2="86" y2="194" style="--d:1300" />
    <line x1="82" y1="48" x2="90" y2="48" style="--d:1350" />
    <line x1="82" y1="194" x2="90" y2="194" style="--d:1350" />
    <line x1="200" y1="194" x2="450" y2="194" style="--d:1400" />
    <line x1="200" y1="190" x2="200" y2="198" style="--d:1450" />
    <line x1="450" y1="190" x2="450" y2="198" style="--d:1450" />
  </g>
</svg>

<span class="absolute top-[47%] left-[3%] -translate-y-1/2 -rotate-90 font-mono text-[10px] tracking-wider text-muted-foreground/80 select-none sm:left-[6%]" aria-hidden="true">
  Android
</span>
<span class="absolute bottom-1.5 left-1/2 translate-x-[30%] font-mono text-[10px] tracking-wider text-muted-foreground/80 select-none" aria-hidden="true">
  Web
</span>
<span class="absolute right-3 bottom-2 hidden font-mono text-[10px] text-muted-foreground/70 select-none sm:block" aria-hidden="true">
  {lang === "tr" ? "ölçek 1:1 · tek geliştirici" : "scale 1:1 · solo developer"}
</span>
<span class="absolute top-2 left-3 font-mono text-[11px] text-muted-foreground select-none" aria-hidden="true">
  <span class="text-foreground/70">$</span> ship --android --web<span class="caret">▍</span>
</span>
