---
import type { Lang } from "@/consts";
import { experience } from "@/data/cv";
import { t } from "@/i18n/ui";
import { formatMonth } from "@/i18n/utils";

interface Props {
  lang: Lang;
  /** Kısa görünüm: yalnız ilk madde. */
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const tr = t(lang);
---

<ol class="relative space-y-8 border-l border-zinc-200 pl-6 dark:border-zinc-800">
  {
    experience.map((job) => (
      <li class="relative">
        <span
          class:list={[
            "absolute top-1.5 -left-[29px] size-2.5 rounded-full ring-4 ring-white dark:ring-zinc-950",
            job.end === null ? "bg-accent-500" : "bg-zinc-300 dark:bg-zinc-700",
          ]}
          aria-hidden="true"
        />
        <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h3 class="font-semibold">
            {job.url ? (
              <a href={job.url} class="link" target="_blank" rel="noopener">
                {job.company}
              </a>
            ) : (
              job.company
            )}
            <span class="font-normal text-zinc-500 dark:text-zinc-400"> · {job.position[lang]}</span>
          </h3>
          <p class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-400">
            {formatMonth(job.start, lang, tr("cv.present"))} – {formatMonth(job.end, lang, tr("cv.present"))}
          </p>
        </div>
        <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{job.location[lang]}</p>
        <ul class="mt-3 space-y-2 text-[15px] leading-relaxed">
          {(compact ? job.highlights[lang].slice(0, 1) : job.highlights[lang]).map((h) => (
            <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:size-1 before:rounded-full before:bg-zinc-400">
              {h}
            </li>
          ))}
        </ul>
        {!compact && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {job.stack.map((s) => (
              <li class="chip">{s}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
