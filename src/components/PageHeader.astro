---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}
const { title, description, eyebrow } = Astro.props;
---

<div class="pt-14 pb-10 sm:pt-20">
  {eyebrow && <p class="mb-3 font-mono text-sm text-accent-700 dark:text-accent-400">{eyebrow}</p>}
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
  {description && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>}
  <slot />
</div>
