---
import type { Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { formatDate, localizePath } from "@/i18n/utils";
import { readingTime, splitId, type Post } from "@/lib/content";

interface Props {
  posts: Post[];
  lang: Lang;
}
const { posts, lang } = Astro.props;
const tr = t(lang);
---

{
  posts.length === 0 ? (
    <p class="text-zinc-500">{tr("blog.empty")}</p>
  ) : (
    <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {posts.map((post) => (
        <li class="group relative py-5 first:pt-0">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
            <time
              datetime={post.data.pubDate.toISOString()}
              class="shrink-0 font-mono text-xs text-zinc-500 sm:w-28 dark:text-zinc-400"
            >
              {formatDate(post.data.pubDate, lang, { month: "short" })}
            </time>
            <div class="space-y-1">
              <h3 class="font-semibold transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-400">
                <a href={localizePath(`/blog/${splitId(post.id).slug}`, lang)} class="after:absolute after:inset-0">
                  {post.data.title}
                  {post.data.draft && <span class="chip ml-2">draft</span>}
                </a>
              </h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
              <p class="font-mono text-xs text-zinc-400 dark:text-zinc-500">
                {readingTime(post.body)} {tr("blog.readingTime")}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  )
}
