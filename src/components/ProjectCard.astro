---
import { Image } from "astro:assets";
import type { Lang } from "@/consts";
import { localizePath } from "@/i18n/utils";
import { splitId, type Project } from "@/lib/content";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  lang: Lang;
  showCover?: boolean;
  wide?: boolean;
}
const { project, lang, showCover = false, wide = false } = Astro.props;
const { slug } = splitId(project.id);
const { title, summary, stack, period, cover, coverAlt, status, links } = project.data;
const href = localizePath(`/projects/${slug}`, lang);
---

<article class:list={["card spotlight group relative flex w-full flex-col overflow-hidden rounded-2xl transition-transform duration-300 hover:-translate-y-1 hover:border-zinc-300 dark:hover:border-zinc-700", wide && "sm:col-span-2"]}>
  {
    showCover && cover ? (
      <div class="aspect-[16/9] overflow-hidden border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900">
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[480, 768]}
          sizes="(min-width: 640px) 368px, 100vw"
          class="size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </div>
    ) : null
  }
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
      <span>{period}</span>
      {status && <span class="text-accent-700 dark:text-accent-400">● {status}</span>}
    </div>
    <h3 class:list={["font-semibold", wide ? "text-xl sm:text-2xl" : "text-lg"]}>
      <a href={href} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <p class="text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{summary}</p>
    <ul class="flex flex-wrap gap-1.5 pt-1">
      {stack.slice(0, 5).map((s) => <li class="chip">{s}</li>)}
    </ul>
    <div class="relative z-10 mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-3 text-xs font-medium text-zinc-500 dark:text-zinc-400">
      {links.live && <a href={links.live} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-zinc-900 dark:hover:text-zinc-100"><Icon name="lucide:globe" class="size-3.5" />{new URL(links.live).hostname}</a>}
      {links.repo && <a href={links.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-zinc-900 dark:hover:text-zinc-100"><Icon name="mdi:github" class="size-3.5" />GitHub</a>}
      {links.demo && <a href={links.demo} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-zinc-900 dark:hover:text-zinc-100"><Icon name="lucide:play" class="size-3.5" />Demo</a>}
    </div>
  </div>
  <Icon
    name="lucide:arrow-up-right"
    class="absolute top-3 right-3 size-5 rounded-full bg-white/90 p-0.5 text-zinc-500 opacity-0 transition-opacity group-hover:opacity-100 dark:bg-zinc-900/90"
  />
</article>
