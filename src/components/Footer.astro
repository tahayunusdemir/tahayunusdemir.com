---
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();

const socials = [
  { href: SITE.github, label: "GitHub", icon: "mdi:github" },
  { href: SITE.linkedin, label: "LinkedIn", icon: "mdi:linkedin" },
  { href: `mailto:${SITE.email}`, label: "E-mail", icon: "lucide:mail" },
];
---

<footer class="mt-16">
  <div class="stripe-divider" aria-hidden="true"></div>
  <div class="screen-line-top screen-line-bottom flex flex-col gap-3 px-4 py-5 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p>© {year} {SITE.name}</p>
      <p class="mt-0.5">
        {tr("footer.built")}{" "}
        <a href={SITE.repo} class="link-underline hover:text-foreground">{tr("footer.source")}</a>
      </p>
    </div>
    <ul class="flex items-center gap-1">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              title={s.label}
              class="grid size-9 place-items-center rounded-md transition-colors hover:bg-accent-muted hover:text-foreground"
              {...(s.href.startsWith("http") ? { rel: "me noopener", target: "_blank" } : {})}
            >
              <Icon name={s.icon} class="size-[18px]" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="h-8" aria-hidden="true"></div>
</footer>
