---
import { SITE, type Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath } from "@/i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();

const socials = [
  { href: SITE.github, label: "GitHub", icon: "mdi:github" },
  { href: SITE.linkedin, label: "LinkedIn", icon: "mdi:linkedin" },
  { href: `mailto:${SITE.email}`, label: "E-mail", icon: "lucide:mail" },
];
---

<footer class="mt-24 border-t border-zinc-200 dark:border-zinc-800">
  <div
    class="container-page flex flex-col gap-4 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:text-zinc-400"
  >
    <div class="space-y-1">
      <p>© {year} {SITE.name}</p>
      <p>
        {tr("footer.built")}
        <a href={SITE.repo} class="underline underline-offset-4 hover:text-zinc-900 dark:hover:text-zinc-100"
          >{tr("footer.source")}</a
        >
      </p>
    </div>
    <ul class="flex items-center gap-1">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              title={s.label}
              class="grid size-9 place-items-center rounded-md transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
              {...(s.href.startsWith("http") ? { rel: "me noopener", target: "_blank" } : {})}
            >
              <Icon name={s.icon} class="size-[18px]" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
