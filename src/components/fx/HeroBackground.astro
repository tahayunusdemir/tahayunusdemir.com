---
// Aurora lekeleri + noktalı ızgara + fareyi izleyen ışık. Tamamen dekoratif.
---

<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true" data-hero-bg>
  <div class="hero-grid absolute inset-0"></div>
  <div
    class="animate-aurora absolute -top-40 left-[10%] size-[520px] rounded-full bg-accent-400/30 blur-[110px] dark:bg-accent-500/20"
  ></div>
  <div
    class="animate-aurora absolute -top-24 right-[5%] size-[440px] rounded-full bg-sky-400/25 blur-[110px] [animation-delay:-6s] dark:bg-sky-500/15"
  ></div>
  <div
    class="animate-aurora absolute top-40 left-[35%] size-[380px] rounded-full bg-violet-400/20 blur-[120px] [animation-delay:-12s] dark:bg-violet-500/15"
  ></div>
  <div
    class="absolute inset-0 opacity-0 transition-opacity duration-500 [background:radial-gradient(600px_circle_at_var(--hx,50%)_var(--hy,30%),rgb(16_185_129/0.12),transparent_45%)] data-[on]:opacity-100"
    data-hero-light
  ></div>
  <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-white dark:to-zinc-950"></div>
</div>
