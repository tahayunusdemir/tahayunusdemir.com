---
import Icon from "@/components/Icon.astro";

const items = [
  ["si:kotlin", "Kotlin"],
  ["si:android", "Android"],
  ["si:jetpackcompose", "Jetpack Compose"],
  ["si:nextdotjs", "Next.js"],
  ["si:react", "React"],
  ["si:typescript", "TypeScript"],
  ["si:tailwindcss", "Tailwind CSS"],
  ["si:supabase", "Supabase"],
  ["si:postgresql", "PostgreSQL"],
  ["si:python", "Python"],
  ["si:fastapi", "FastAPI"],
  ["si:django", "Django"],
  ["si:mongodb", "MongoDB"],
  ["si:flutter", "Flutter"],
  ["si:firebase", "Firebase"],
  ["si:docker", "Docker"],
  ["si:githubactions", "GitHub Actions"],
  ["si:figma", "Figma"],
] as const;
---

<div class="marquee-mask relative overflow-hidden py-2" aria-label="Tech stack">
  <ul class="marquee-track flex w-max items-center gap-10">
    {
      [...items, ...items].map(([icon, label], i) => (
        <li
          class="flex items-center gap-2.5 text-zinc-400 transition-colors hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100"
          aria-hidden={i >= items.length ? "true" : undefined}
        >
          <Icon name={icon} class="size-6" />
          <span class="text-sm font-medium whitespace-nowrap">{label}</span>
        </li>
      ))
    }
  </ul>
</div>
