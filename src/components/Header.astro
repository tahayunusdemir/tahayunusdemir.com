---
import type { Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath, stripLang } from "@/i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const tr = t(lang);
const current = stripLang(Astro.url.pathname).replace(/\/$/, "") || "/";

const nav = [
  { href: "/projects", label: tr("nav.projects") },
  { href: "/cv", label: tr("nav.cv") },
];
const isActive = (href: string) => current === href || current.startsWith(href + "/");
---

<header class="screen-line-bottom sticky top-0 z-40 bg-background/80 backdrop-blur-md">
  <div class="flex h-12 items-center justify-between gap-2 px-4">
    <a
      href={localizePath("/", lang)}
      class="font-mono text-sm font-medium tracking-tight whitespace-nowrap"
      aria-label={tr("nav.home")}
    >
      tahayunusdemir<span class="text-muted-foreground">.com</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-0.5">
      {
        nav.map((item) => (
          <a
            href={localizePath(item.href, lang)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-md px-2.5 py-1 text-sm transition-colors",
              isActive(item.href) ? "text-foreground" : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <span class="mx-1.5 h-4 w-px bg-line" aria-hidden="true"></span>
      <a
        href={altHref}
        hreflang={lang === "tr" ? "en" : "tr"}
        aria-label={tr("lang.switchLabel")}
        title={tr("lang.switchLabel")}
        class="grid h-8 place-items-center rounded-md px-2 font-mono text-xs text-muted-foreground uppercase transition-colors hover:bg-accent-muted hover:text-foreground"
        >{lang === "tr" ? "EN" : "TR"}</a
      >
      <button
        type="button"
        data-theme-toggle
        aria-label={tr("theme.toggle")}
        title={tr("theme.toggle")}
        class="grid size-8 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent-muted hover:text-foreground"
      >
        <Icon name="lucide:sun" class="hidden size-4 dark:block" />
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  btn?.addEventListener("click", () => {
    const apply = () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {
        /* depolama kapalı */
      }
    };
    // Destekleyen tarayıcılarda yumuşak tema geçişi.
    const doc = document as Document & { startViewTransition?: (cb: () => void) => void };
    if (doc.startViewTransition && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      doc.startViewTransition(apply);
    } else apply();
  });
</script>
