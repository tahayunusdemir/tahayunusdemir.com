---
import type { Lang } from "@/consts";
import { t } from "@/i18n/ui";
import { localizePath, stripLang } from "@/i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const tr = t(lang);
const current = stripLang(Astro.url.pathname).replace(/\/$/, "") || "/";

const nav = [
  { href: "/projects", label: tr("nav.projects") },
  { href: "/blog", label: tr("nav.blog") },
  { href: "/cv", label: tr("nav.cv") },
  { href: "/about", label: tr("nav.about") },
];
const isActive = (href: string) => current === href || current.startsWith(href + "/");
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/80 backdrop-blur-md dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
  <div class="container-page flex h-14 items-center justify-between gap-2 sm:gap-4">
    <a
      href={localizePath("/", lang)}
      class="group flex items-center gap-2 font-semibold text-zinc-900 dark:text-zinc-100"
      aria-label={tr("nav.home")}
    >
      <span
        class="grid size-7 shrink-0 place-items-center rounded-md bg-zinc-900 font-mono text-[11px] font-bold text-white transition-colors group-hover:bg-accent-600 dark:bg-zinc-100 dark:text-zinc-900"
        >TYD</span
      >
      <span class="hidden sm:inline">Taha Yunus Demir</span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-0.5 sm:gap-1">
      {
        nav.map((item) => (
          <a
            href={localizePath(item.href, lang)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "rounded-md px-1.5 py-1.5 text-[13px] transition-colors sm:px-3 sm:text-sm",
              isActive(item.href)
                ? "font-medium text-zinc-900 dark:text-white"
                : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <span class="mx-1 hidden h-5 w-px bg-zinc-200 sm:block dark:bg-zinc-800" aria-hidden="true"></span>
      <a
        href={altHref}
        hreflang={lang === "tr" ? "en" : "tr"}
        aria-label={tr("lang.switchLabel")}
        title={tr("lang.switchLabel")}
        class="rounded-md px-1.5 py-1.5 font-mono text-xs font-medium text-zinc-500 uppercase transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
        >{lang === "tr" ? "EN" : "TR"}</a
      >
      <button
        type="button"
        data-theme-toggle
        aria-label={tr("theme.toggle")}
        title={tr("theme.toggle")}
        class="grid size-7 place-items-center rounded-md sm:size-8 text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
      >
        <Icon name="lucide:sun" class="hidden size-4 dark:block" />
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  btn?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      /* depolama kapalı */
    }
  });
</script>
